# Image and network
DSH_IMAGE=razeencheng/dsh:latest
DSH_BIND_ADDRESS=127.0.0.1
DSH_HOST_PORT=3080
DSH_CONTAINER_PORT=3080

# Add the public hostname or host:port used by the browser/reverse proxy.
# Examples: harness.example.com or harness.example.com:443
DSH_TRUSTED_HOST=127.0.0.1:3080

# Provider credentials
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_SEARCH_BASE_URL=

# Runtime policy
DSH_PERMISSION_MODE=workspace-write
DSH_TOOLS_MODE=native
DSH_TELEMETRY_DISABLED=1

# Optional outbound proxy
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,dsh

# Resource and log limits
DSH_MEMORY_LIMIT=4g
DSH_CPU_LIMIT=4.0
DSH_LOG_MAX_SIZE=20m
DSH_LOG_MAX_FILES=5

# Optional: only used with docker-compose.docker.yml
# DOCKER_GID=999
